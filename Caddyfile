{
	auto_https disable_redirects
	default_sni {$TM_PUBLIC_IP}
}

https://{$TM_PUBLIC_IP} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
			disable_http_challenge
		}
	}

	redir /tm-law-agent /tm-law-agent/ 308
	handle /tm-law-agent/* {
		reverse_proxy app:8501
	}
	handle {
		respond 404
	}
}
