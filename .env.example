# 复制为 .env 后填写。.env 不进入代码仓库。

# 大模型（OpenAI 兼容接口）。不填也能运行：解释和结论走降级路径（代码生成的理由 + 模板）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 模型 ID 请按 DeepSeek 控制台 / 接口文档里的写法填写（即 V4.1-Flash-1017 对应的 API 模型名）
LLM_MODEL=
# 模型调用超时（秒）。验收“模型超时”路径时改成 1
LLM_TIMEOUT=20
# 每次评估最多为多少个名称组调用大模型（其余用模板）
LLM_MAX_GROUPS=10

# 向量模型：bge（本地 bge-small-zh-v1.5，首次建库下载约 100 MB）或 hash（不下载，语义效果差）
EMBED_BACKEND=bge
# 下载 bge 模型走镜像（官方源连不上时使用）
# HF_ENDPOINT=https://hf-mirror.com

# 正式商标库后端：sqlite（开放数据）或 none（只用本地记录）
TM_LIBRARY=sqlite
# 商标开放数据：SQLite 原库路径（约 10 GB，放在项目外，只读）；检索索引路径默认 data/open_index.sqlite
TM_OPEN_DB=
# TM_OPEN_INDEX=

# 注册密钥由管理员发给受邀用户，留空则关闭注册
TM_REGISTRATION_KEY=
# 使用 compose.public.yml 开启 IP HTTPS 入口时填写公网 IPv4
# TM_PUBLIC_IP=

# 注册邮箱验证码的发信服务（SMTP）。QQ / 163 邮箱需在邮箱设置里开启 SMTP 并使用“授权码”作为密码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=
# 465 端口用 SSL（1）；587 端口用 STARTTLS（0）
SMTP_SSL=1
# 本机调试：不发邮件，验证码直接显示在注册窗口里。正式部署务必删除
# TM_EMAIL_DEV=1
